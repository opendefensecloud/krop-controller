{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests", "docker:pinDigests"],
  "minimumReleaseAge": "1 day",
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "minimumReleaseAge": "0"
  },
  "nix": {
    "enabled": true
  },
  "postUpdateOptions": ["gomodTidy"],
  "packageRules": [
    {
      "matchManagers": ["gomod"],
      "matchDepTypes": ["golang"],
      "rangeStrategy": "bump"
    },
    {
      "matchDatasources": ["docker", "golang-version"],
      "matchPackageNames": ["go", "golang"],
      "groupName": "golang version sync",
      "groupSlug": "go-version"
    },
    {
      "description": "kcp (sdk 0.33) and multicluster-provider don't support Kubernetes 0.37 yet. controller-runtime and multicluster-runtime 0.25 and controller-tools 0.24 require it, so they are held too. Lift all four rules together.",
      "matchPackageNames": ["/^k8s\\.io/(api|apimachinery|apiextensions-apiserver|apiserver|client-go|component-base)$/"],
      "allowedVersions": "<0.37.0"
    },
    {
      "matchPackageNames": ["sigs.k8s.io/controller-runtime", "sigs.k8s.io/multicluster-runtime"],
      "allowedVersions": "<0.25.0"
    },
    {
      "matchDepNames": ["controller-gen"],
      "allowedVersions": "<0.24.0"
    },
    {
      "description": "kro v0.10 removed pkg/runtime, which the engine is built on. See #75.",
      "matchPackageNames": ["github.com/kubernetes-sigs/kro"],
      "allowedVersions": "<0.10.0"
    },
    {
      "description": "The chart's own image follows appVersion, which the release workflow sets; a pinned digest would override it in every release",
      "matchManagers": ["helm-values"],
      "matchPackageNames": ["ghcr.io/opendefensecloud/krop-controller"],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)flake\\.nix$/"],
      "matchStrings": [
        "goVersion\\s*=\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "go",
      "datasourceTemplate": "golang-version"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "Makefile"
      ],
      "matchStrings": [
        "DEV_KIT_VERSION := (?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "opendefensecloud/dev-kit",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "tools.lock"
      ],
      "matchStrings": [
        "(?<depName>[^\\s]+) (?<packageName>[^@]+)@(?<currentValue>v?[^\\s]+)"
      ],
      "versioningTemplate": "semver",
      "datasourceTemplate": "go"
    }
  ]
}
